{
  "manifest_version": 3,
  "name": "Kai Bridge",
  "version": "0.3.0",
  "description": "Connects the Kai terminal agent to your DeepSeek or Qwen web chat. Install it, open chat.deepseek.com or chat.qwen.ai, run kai.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "scripting",
    "debugger"
  ],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "https://chat.qwen.ai/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kai Bridge"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*",
        "https://chat.qwen.ai/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chat.deepseek.com/*",
        "https://chat.qwen.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
