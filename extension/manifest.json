{
  "manifest_version": 3,
  "name": "Kai Bridge",
  "version": "0.2.0",
  "description": "Connects the Kai terminal agent to your DeepSeek web chat. Install it, open chat.deepseek.com, run kai.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "tabs", "alarms", "scripting", "debugger"],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Kai Bridge" },
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
