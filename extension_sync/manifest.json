{
  "manifest_version": 3,
  "name": "Kai DeepSeek Sync",
  "version": "1.0",
  "description": "Keeps Kai supplied with this browser's DeepSeek session.",
  "permissions": ["cookies", "webRequest", "storage", "alarms", "tabs"],
  "host_permissions": ["https://chat.deepseek.com/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" }
}